# виртуальное окружение
.venv/
# python служебные
__pycache__/
*.pyc
*.pyo
*.pyd
# env
.env
*.env
*.env.*
!.env.example
!*.env.example
!**/*.env.example

# local intData-tools runtime/state/secrets
.runtime/
# IDE
.vscode/
.idea/

# project env files
**/.env
**/*.log


# ENV POLICY (strict)
.env
.env.*
**/*.env
config/runtime/*.env
!*.env.example
!**/*.env.example
!*.example
!**/*.example

# external local reference clone (not tracked in intData-tools)
ngt-memory/

# local unpacked memory-bank artifacts (not tracked in intData-tools)
mcp-memory-bank/

# local dependency/build artifacts
node_modules/
**/node_modules/

# local/legacy Codex app runtime artifacts; plugin source lives under .codex/
.agents/

# Graphify generated state
graphify-out/cache/
graphify-out/graph.json
graphify-out/graph.html
graphify-out/GRAPH_REPORT.md
graphify-out/manifest.json
graphify-out/cost.json
