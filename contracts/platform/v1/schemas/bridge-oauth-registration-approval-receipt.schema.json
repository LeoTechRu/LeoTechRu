{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:intdata:schema:bridge-oauth-registration-approval-receipt:v1",
  "title": "BridgeOAuthRegistrationApprovalReceiptV1",
  "$comment": "Closed decoded JWT conformance representation. Compact JWS bytes, signatures and software statements remain inside the private Bridge/Backend control plane. Semantic conformance binds the admitted kid to trust role bridge.oauth.registration-approval, central or InstallationLockV1 Lite authorities, trusted verifier time, exact PlatformProductAssertionV1 projections, single-use JTIs and RFC 8785 registration metadata digests normalized only by bridge-oauth-registration-uri/v1.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "protected_header", "claims"],
  "properties": {
    "schema_version": { "const": "BridgeOAuthRegistrationApprovalReceiptV1" },
    "protected_header": {
      "type": "object",
      "additionalProperties": false,
      "required": ["typ", "alg", "kid"],
      "properties": {
        "typ": { "const": "bridge-oauth-registration-approval+jwt" },
        "alg": { "const": "ES256" },
        "kid": { "type": "string", "pattern": "^[A-Za-z0-9._-]{1,128}$" }
      }
    },
    "claims": { "$ref": "#/$defs/claims" }
  },
  "$defs": {
    "claims": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "iss",
        "aud",
        "sub",
        "principal_type",
        "organization_id",
        "session_id",
        "membership_revision",
        "entitlement_revision",
        "registration_metadata_digest",
        "jti",
        "iat",
        "nbf",
        "exp"
      ],
      "properties": {
        "iss": { "$ref": "#/$defs/https_uri" },
        "aud": { "$ref": "#/$defs/https_uri" },
        "sub": { "$ref": "#/$defs/canonical_uuid" },
        "principal_type": { "const": "user" },
        "organization_id": { "$ref": "#/$defs/canonical_uuid" },
        "session_id": { "$ref": "#/$defs/session_id" },
        "membership_revision": { "$ref": "#/$defs/safe_nonnegative_integer" },
        "entitlement_revision": { "$ref": "#/$defs/safe_nonnegative_integer" },
        "registration_metadata_digest": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
        "jti": { "type": "string", "pattern": "^[A-Za-z0-9_-]{16,128}$" },
        "iat": { "$ref": "#/$defs/safe_nonnegative_integer" },
        "nbf": { "$ref": "#/$defs/safe_nonnegative_integer" },
        "exp": { "$ref": "#/$defs/safe_nonnegative_integer" }
      }
    },
    "canonical_uuid": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[1-5][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "https_uri": {
      "type": "string",
      "format": "uri",
      "maxLength": 2048,
      "pattern": "^https://(?:[A-Za-z0-9](?:[A-Za-z0-9-]{0,61}[A-Za-z0-9])?\\.)+[A-Za-z](?:[A-Za-z0-9-]{0,61}[A-Za-z0-9])?(?::[1-9][0-9]{0,4})?(?:/[A-Za-z0-9._~!$&'()*+,;=:@%/-]*)?$"
    },
    "session_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9._:-]{1,128}$"
    },
    "safe_nonnegative_integer": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    }
  }
}
