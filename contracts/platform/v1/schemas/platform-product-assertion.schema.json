{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:intdata:schema:platform-product-assertion:v1",
  "title": "PlatformProductAssertionV1",
  "$comment": "Closed #887 wire wrapper. The protected header is exact; RFC 8785 canonicalization and the dedicated conformance hash cover the claims object only. Semantic conformance binds configured iss and scalar aud and enforces trusted verifier_now, skew and 60-second TTL rules.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "protected_header", "claims"],
  "properties": {
    "schema_version": { "const": "PlatformProductAssertionV1" },
    "protected_header": {
      "type": "object",
      "additionalProperties": false,
      "required": ["typ", "alg", "kid"],
      "properties": {
        "typ": { "const": "at+jwt" },
        "alg": { "const": "ES256" },
        "kid": { "type": "string", "pattern": "^[A-Za-z0-9._-]{1,128}$" }
      }
    },
    "claims": { "$ref": "#/$defs/claims" }
  },
  "$defs": {
    "claims": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "iss",
        "aud",
        "sub",
        "principal_type",
        "organization_id",
        "product_id",
        "client_id",
        "session_id",
        "scopes",
        "entitlement_revision",
        "membership_revision",
        "jti",
        "iat",
        "nbf",
        "exp"
      ],
      "properties": {
        "iss": { "$ref": "#/$defs/https_authority" },
        "aud": { "$ref": "#/$defs/https_authority" },
        "sub": { "$ref": "#/$defs/canonical_uuid" },
        "principal_type": { "enum": ["user", "service_account"] },
        "organization_id": { "$ref": "#/$defs/canonical_uuid" },
        "product_id": { "type": "string", "pattern": "^[a-z0-9](?:[a-z0-9-]{0,62}[a-z0-9])?$" },
        "client_id": { "$ref": "#/$defs/client_or_session_id" },
        "session_id": { "$ref": "#/$defs/client_or_session_id" },
        "scopes": {
          "type": "array",
          "minItems": 1,
          "maxItems": 64,
          "uniqueItems": true,
          "items": { "type": "string", "pattern": "^[a-z][a-z0-9.-]{0,31}:[a-z][a-z0-9.-]{0,63}$" }
        },
        "entitlement_revision": { "$ref": "#/$defs/safe_nonnegative_integer" },
        "membership_revision": { "$ref": "#/$defs/safe_nonnegative_integer" },
        "jti": { "type": "string", "pattern": "^[A-Za-z0-9_-]{16,128}$" },
        "iat": { "$ref": "#/$defs/safe_nonnegative_integer" },
        "nbf": { "$ref": "#/$defs/safe_nonnegative_integer" },
        "exp": { "$ref": "#/$defs/safe_nonnegative_integer" }
      }
    },
    "canonical_uuid": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[1-5][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "https_authority": {
      "type": "string",
      "format": "uri",
      "pattern": "^https://(?:[A-Za-z0-9](?:[A-Za-z0-9-]{0,61}[A-Za-z0-9])?\\.)+[A-Za-z](?:[A-Za-z0-9-]{0,61}[A-Za-z0-9])?(?::[1-9][0-9]{0,4})?$"
    },
    "client_or_session_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9._:-]{1,128}$"
    },
    "safe_nonnegative_integer": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    }
  }
}
