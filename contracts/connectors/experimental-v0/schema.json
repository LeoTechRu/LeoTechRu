{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://intdata.pro/contracts/connectors/experimental-v0/schema.json",
  "title": "Experimental Connector Contracts V0",
  "oneOf": [
    { "$ref": "#/$defs/event_envelope" },
    { "$ref": "#/$defs/action_plan" },
    { "$ref": "#/$defs/effect_grant" },
    { "$ref": "#/$defs/effect_receipt" },
    { "$ref": "#/$defs/connector_capability" },
    { "$ref": "#/$defs/connector_error" }
  ],
  "$defs": {
    "identifier": {
      "type": "string",
      "minLength": 3,
      "maxLength": 128,
      "pattern": "^[a-z][a-z0-9]*(?:[._:-][a-z0-9]+)*$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "timestamp": {
      "type": "string",
      "format": "date-time",
      "pattern": "Z$"
    },
    "principal": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "kind"],
      "properties": {
        "id": { "$ref": "#/$defs/identifier" },
        "kind": { "enum": ["user", "agent", "service"] }
      }
    },
    "versioned_component": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "version", "digest"],
      "properties": {
        "id": { "$ref": "#/$defs/identifier" },
        "version": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._+-]*$"
        },
        "digest": { "$ref": "#/$defs/sha256" }
      }
    },
    "digest_assertion": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "digest"],
      "properties": {
        "kind": {
          "enum": [
            "resource_snapshot",
            "version_match",
            "provider_read_after_write",
            "target_state"
          ]
        },
        "digest": { "$ref": "#/$defs/sha256" }
      }
    },
    "artifact_hash": {
      "type": "object",
      "additionalProperties": false,
      "required": ["media_type", "sha256", "size_bytes"],
      "properties": {
        "media_type": {
          "type": "string",
          "minLength": 3,
          "maxLength": 128,
          "pattern": "^[a-z0-9.+-]+/[a-z0-9.+-]+$"
        },
        "sha256": { "$ref": "#/$defs/sha256" },
        "size_bytes": { "type": "integer", "minimum": 0, "maximum": 16777216 }
      }
    },
    "event_envelope": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "message_type",
        "contract_version",
        "event_id",
        "bridge_id",
        "tenant_id",
        "contour",
        "source",
        "event_type",
        "subject",
        "occurred_at",
        "received_at",
        "schema_version",
        "compiler_version",
        "trace",
        "idempotency_digest",
        "payload_ref"
      ],
      "properties": {
        "message_type": { "const": "event_envelope" },
        "contract_version": { "const": "connectors-experimental-v0" },
        "event_id": { "$ref": "#/$defs/identifier" },
        "bridge_id": { "$ref": "#/$defs/identifier" },
        "tenant_id": { "$ref": "#/$defs/identifier" },
        "contour": { "enum": ["dev", "staging", "production"] },
        "source": {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "provider", "connection_id"],
          "properties": {
            "kind": { "enum": ["webhook", "poll", "schedule", "manual", "agent"] },
            "provider": { "$ref": "#/$defs/identifier" },
            "connection_id": { "$ref": "#/$defs/identifier" }
          }
        },
        "event_type": { "$ref": "#/$defs/identifier" },
        "subject": { "$ref": "#/$defs/identifier" },
        "occurred_at": { "$ref": "#/$defs/timestamp" },
        "received_at": { "$ref": "#/$defs/timestamp" },
        "schema_version": { "type": "integer", "minimum": 1, "maximum": 2147483647 },
        "compiler_version": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._+-]{0,63}$" },
        "trace": {
          "type": "object",
          "additionalProperties": false,
          "required": ["trace_id", "span_id"],
          "properties": {
            "trace_id": { "type": "string", "pattern": "^[a-f0-9]{32}$" },
            "span_id": { "type": "string", "pattern": "^[a-f0-9]{16}$" },
            "parent_span_id": { "type": "string", "pattern": "^[a-f0-9]{16}$" }
          }
        },
        "idempotency_digest": { "$ref": "#/$defs/sha256" },
        "payload_ref": {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "ref", "sha256"],
          "properties": {
            "kind": { "const": "encrypted_blob" },
            "ref": { "$ref": "#/$defs/identifier" },
            "sha256": { "$ref": "#/$defs/sha256" }
          }
        }
      }
    },
    "action_plan": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "message_type",
        "contract_version",
        "plan_id",
        "plan_version",
        "tenant_id",
        "contour",
        "workflow",
        "policy",
        "connector",
        "connection_id",
        "requesting_principal",
        "authorization_decision_digest",
        "policy_revision",
        "effect_class",
        "operation",
        "target_digest",
        "arguments_digest",
        "preconditions",
        "verification_assertions",
        "grant_required",
        "created_at"
      ],
      "properties": {
        "message_type": { "const": "action_plan" },
        "contract_version": { "const": "connectors-experimental-v0" },
        "plan_id": { "$ref": "#/$defs/identifier" },
        "plan_version": { "const": "ActionPlanV1" },
        "tenant_id": { "$ref": "#/$defs/identifier" },
        "contour": { "enum": ["dev", "staging", "production"] },
        "workflow": { "$ref": "#/$defs/versioned_component" },
        "policy": { "$ref": "#/$defs/versioned_component" },
        "connector": { "$ref": "#/$defs/versioned_component" },
        "connection_id": { "$ref": "#/$defs/identifier" },
        "requesting_principal": { "$ref": "#/$defs/principal" },
        "approving_principal": { "$ref": "#/$defs/principal" },
        "approving_role": { "$ref": "#/$defs/identifier" },
        "authorization_decision_digest": { "$ref": "#/$defs/sha256" },
        "policy_revision": { "type": "integer", "minimum": 1 },
        "effect_class": { "enum": ["read_snapshot", "provider_effect"] },
        "operation": { "$ref": "#/$defs/identifier" },
        "target_digest": { "$ref": "#/$defs/sha256" },
        "arguments_digest": { "$ref": "#/$defs/sha256" },
        "preconditions": {
          "type": "array",
          "maxItems": 32,
          "items": { "$ref": "#/$defs/digest_assertion" }
        },
        "verification_assertions": {
          "type": "array",
          "maxItems": 32,
          "items": { "$ref": "#/$defs/digest_assertion" }
        },
        "grant_required": { "type": "boolean" },
        "created_at": { "$ref": "#/$defs/timestamp" }
      },
      "allOf": [
        {
          "if": { "properties": { "effect_class": { "const": "read_snapshot" } }, "required": ["effect_class"] },
          "then": {
            "properties": { "grant_required": { "const": false } },
            "not": { "anyOf": [ { "required": ["approving_principal"] }, { "required": ["approving_role"] } ] }
          }
        },
        {
          "if": { "properties": { "effect_class": { "const": "provider_effect" } }, "required": ["effect_class"] },
          "then": {
            "required": ["approving_principal", "approving_role"],
            "properties": { "grant_required": { "const": true } }
          }
        }
      ]
    },
    "effect_grant": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "message_type",
        "contract_version",
        "grant_version",
        "grant_id",
        "issuer",
        "audience",
        "tenant_id",
        "contour",
        "subject",
        "approving_principal",
        "approving_role",
        "authorization_decision_digest",
        "policy_revision",
        "plan_digest",
        "connection_id",
        "operation",
        "target_digest",
        "grant_class",
        "constraints",
        "not_before_epoch",
        "expires_epoch",
        "nonce",
        "revision",
        "revocation_snapshot_digest",
        "revocation_snapshot_revision",
        "revocation_snapshot_issued_epoch",
        "revocation_snapshot_expires_epoch",
        "claims_digest",
        "signature"
      ],
      "properties": {
        "message_type": { "const": "effect_grant" },
        "contract_version": { "const": "connectors-experimental-v0" },
        "grant_version": { "const": "EffectGrantV1" },
        "grant_id": { "$ref": "#/$defs/identifier" },
        "issuer": { "$ref": "#/$defs/identifier" },
        "audience": { "const": "intdata-bridge" },
        "tenant_id": { "$ref": "#/$defs/identifier" },
        "contour": { "enum": ["dev", "staging", "production"] },
        "subject": { "$ref": "#/$defs/principal" },
        "approving_principal": { "$ref": "#/$defs/principal" },
        "approving_role": { "$ref": "#/$defs/identifier" },
        "authorization_decision_digest": { "$ref": "#/$defs/sha256" },
        "policy_revision": { "type": "integer", "minimum": 1 },
        "plan_digest": { "$ref": "#/$defs/sha256" },
        "connection_id": { "$ref": "#/$defs/identifier" },
        "operation": { "$ref": "#/$defs/identifier" },
        "target_digest": { "$ref": "#/$defs/sha256" },
        "grant_class": { "enum": ["one_time", "persistent"] },
        "constraints": {
          "type": "object",
          "additionalProperties": false,
          "required": ["max_effects", "max_batch", "target_set_digest"],
          "properties": {
            "max_effects": { "type": "integer", "minimum": 1, "maximum": 100000 },
            "max_batch": { "type": "integer", "minimum": 1, "maximum": 10000 },
            "target_set_digest": { "$ref": "#/$defs/sha256" },
            "schedule_digest": { "$ref": "#/$defs/sha256" },
            "rate_per_minute": { "type": "integer", "minimum": 1, "maximum": 100000 }
          }
        },
        "not_before_epoch": { "type": "integer", "minimum": 0 },
        "expires_epoch": { "type": "integer", "minimum": 1 },
        "nonce": { "$ref": "#/$defs/identifier" },
        "revision": { "type": "integer", "minimum": 1 },
        "revocation_snapshot_digest": { "$ref": "#/$defs/sha256" },
        "revocation_snapshot_revision": { "type": "integer", "minimum": 1 },
        "revocation_snapshot_issued_epoch": { "type": "integer", "minimum": 0 },
        "revocation_snapshot_expires_epoch": { "type": "integer", "minimum": 1 },
        "claims_digest": { "$ref": "#/$defs/sha256" },
        "signature": {
          "type": "object",
          "additionalProperties": false,
          "required": ["alg", "kid", "protected", "payload", "signature"],
          "properties": {
            "alg": { "const": "EdDSA" },
            "kid": { "$ref": "#/$defs/identifier" },
            "protected": { "type": "string", "pattern": "^[A-Za-z0-9_-]{8,512}$" },
            "payload": { "type": "string", "pattern": "^[A-Za-z0-9_-]{8,8192}$" },
            "signature": { "type": "string", "pattern": "^[A-Za-z0-9_-]{32,256}$" }
          }
        }
      },
      "allOf": [
        {
          "if": { "properties": { "grant_class": { "const": "one_time" } }, "required": ["grant_class"] },
          "then": {
            "properties": {
              "constraints": {
                "properties": { "max_effects": { "const": 1 } },
                "not": { "anyOf": [ { "required": ["schedule_digest"] }, { "required": ["rate_per_minute"] } ] }
              }
            }
          }
        },
        {
          "if": { "properties": { "grant_class": { "const": "persistent" } }, "required": ["grant_class"] },
          "then": { "properties": { "constraints": { "required": ["schedule_digest", "rate_per_minute"] } } }
        }
      ]
    },
    "effect_receipt": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "message_type",
        "contract_version",
        "receipt_version",
        "receipt_id",
        "tenant_id",
        "contour",
        "connection_id",
        "operation",
        "plan_digest",
        "grant_digest",
        "request_digest",
        "provider_operation_ref",
        "fence",
        "started_at",
        "ended_at",
        "outcome",
        "verification_state",
        "artifacts",
        "terminal_state"
      ],
      "properties": {
        "message_type": { "const": "effect_receipt" },
        "contract_version": { "const": "connectors-experimental-v0" },
        "receipt_version": { "const": "EffectReceiptV1" },
        "receipt_id": { "$ref": "#/$defs/identifier" },
        "tenant_id": { "$ref": "#/$defs/identifier" },
        "contour": { "enum": ["dev", "staging", "production"] },
        "connection_id": { "$ref": "#/$defs/identifier" },
        "operation": { "$ref": "#/$defs/identifier" },
        "plan_digest": { "$ref": "#/$defs/sha256" },
        "grant_digest": { "$ref": "#/$defs/sha256" },
        "request_digest": { "$ref": "#/$defs/sha256" },
        "provider_operation_ref": { "$ref": "#/$defs/identifier" },
        "fence": { "type": "integer", "minimum": 1 },
        "started_at": { "$ref": "#/$defs/timestamp" },
        "ended_at": { "$ref": "#/$defs/timestamp" },
        "outcome": { "enum": ["succeeded", "failed", "cancelled", "indeterminate"] },
        "verification_state": { "enum": ["verified", "failed", "not_applicable", "indeterminate"] },
        "artifacts": {
          "type": "array",
          "maxItems": 32,
          "items": { "$ref": "#/$defs/artifact_hash" }
        },
        "terminal_state": { "enum": ["terminal", "indeterminate"] }
      },
      "allOf": [
        {
          "if": { "properties": { "outcome": { "const": "succeeded" } }, "required": ["outcome"] },
          "then": {
            "properties": {
              "verification_state": { "const": "verified" },
              "terminal_state": { "const": "terminal" }
            }
          }
        },
        {
          "if": { "properties": { "outcome": { "const": "indeterminate" } }, "required": ["outcome"] },
          "then": {
            "properties": {
              "verification_state": { "const": "indeterminate" },
              "terminal_state": { "const": "indeterminate" }
            }
          }
        },
        {
          "if": { "properties": { "outcome": { "const": "failed" } }, "required": ["outcome"] },
          "then": {
            "properties": {
              "verification_state": { "const": "failed" },
              "terminal_state": { "const": "terminal" }
            }
          }
        },
        {
          "if": { "properties": { "outcome": { "const": "cancelled" } }, "required": ["outcome"] },
          "then": {
            "properties": {
              "verification_state": { "const": "not_applicable" },
              "terminal_state": { "const": "terminal" }
            }
          }
        }
      ]
    },
    "connector_capability": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "message_type",
        "contract_version",
        "capability_version",
        "connector_id",
        "connector_version",
        "supported_contract_versions",
        "operations",
        "error_codes"
      ],
      "properties": {
        "message_type": { "const": "connector_capability" },
        "contract_version": { "const": "connectors-experimental-v0" },
        "capability_version": { "const": "ConnectorCapabilityV1" },
        "connector_id": { "$ref": "#/$defs/identifier" },
        "connector_version": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._+-]{0,63}$" },
        "supported_contract_versions": {
          "type": "array",
          "minItems": 1,
          "maxItems": 8,
          "uniqueItems": true,
          "items": { "const": "connectors-experimental-v0" }
        },
        "operations": {
          "type": "array",
          "minItems": 1,
          "maxItems": 128,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["operation", "effect_class", "grant_required", "network_methods", "max_batch"],
            "properties": {
              "operation": { "$ref": "#/$defs/identifier" },
              "effect_class": { "enum": ["read_snapshot", "provider_effect"] },
              "grant_required": { "type": "boolean" },
              "network_methods": {
                "type": "array",
                "minItems": 1,
                "maxItems": 4,
                "uniqueItems": true,
                "items": { "enum": ["GET", "POST", "PATCH", "DELETE"] }
              },
              "max_batch": { "type": "integer", "minimum": 1, "maximum": 10000 }
            },
            "allOf": [
              {
                "if": { "properties": { "effect_class": { "const": "read_snapshot" } }, "required": ["effect_class"] },
                "then": {
                  "properties": {
                    "grant_required": { "const": false },
                    "network_methods": { "prefixItems": [ { "const": "GET" } ], "maxItems": 1 }
                  }
                }
              },
              {
                "if": { "properties": { "effect_class": { "const": "provider_effect" } }, "required": ["effect_class"] },
                "then": { "properties": { "grant_required": { "const": true } } }
              }
            ]
          }
        },
        "error_codes": {
          "type": "array",
          "minItems": 1,
          "maxItems": 16,
          "uniqueItems": true,
          "items": {
            "enum": [
              "auth_unavailable",
              "rate_limited",
              "timeout",
              "validation_failed",
              "provider_conflict",
              "capability_unsupported",
              "network_unavailable",
              "indeterminate"
            ]
          }
        }
      }
    },
    "connector_error": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "message_type",
        "contract_version",
        "error_version",
        "error_id",
        "tenant_id",
        "contour",
        "connector_id",
        "operation",
        "code",
        "retry_class",
        "occurred_at",
        "trace_id"
      ],
      "properties": {
        "message_type": { "const": "connector_error" },
        "contract_version": { "const": "connectors-experimental-v0" },
        "error_version": { "const": "ConnectorErrorV1" },
        "error_id": { "$ref": "#/$defs/identifier" },
        "tenant_id": { "$ref": "#/$defs/identifier" },
        "contour": { "enum": ["dev", "staging", "production"] },
        "connector_id": { "$ref": "#/$defs/identifier" },
        "operation": { "$ref": "#/$defs/identifier" },
        "code": {
          "enum": [
            "auth_unavailable",
            "rate_limited",
            "timeout",
            "validation_failed",
            "provider_conflict",
            "capability_unsupported",
            "network_unavailable",
            "indeterminate"
          ]
        },
        "retry_class": { "enum": ["never", "bounded", "reconcile_only"] },
        "occurred_at": { "$ref": "#/$defs/timestamp" },
        "trace_id": { "type": "string", "pattern": "^[a-f0-9]{32}$" }
      },
      "allOf": [
        {
          "if": { "properties": { "code": { "const": "indeterminate" } }, "required": ["code"] },
          "then": { "properties": { "retry_class": { "const": "reconcile_only" } } }
        }
      ]
    }
  }
}
